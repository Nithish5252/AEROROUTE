# ============================================================
# AeroRoute -- Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================

# -- MongoDB Connection ---------------------------------------
# Local MongoDB 4.4 running on default port
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=aeroroutedb

# -- Data Paths (relative to project root) -------------------
RAW_DATA_DIR=../archive
FLIGHTS_CSV=../archive/flights.csv
AIRPORTS_CSV=../archive/airports.csv
AIRLINES_CSV=../archive/airlines.csv
PROCESSED_DIR=data/processed
EXPORTS_DIR=data/exports

# -- Ingestion Settings --------------------------------------
CHUNK_SIZE=50000
LOG_LEVEL=INFO

# -- MongoDB Collection Names --------------------------------
FLIGHTS_COLLECTION=flights
AIRPORTS_COLLECTION=airports
AIRLINES_COLLECTION=airlines

# -- MapReduce Output Collections ----------------------------
MR_ROUTE_ACTIVITY=mr_route_activity
MR_AIRPORT_OUTGOING=mr_airport_outgoing
MR_AIRPORT_INCOMING=mr_airport_incoming
MR_MONTHLY_ROUTE=mr_monthly_route
MR_AIRPORT_CONNECTIVITY=mr_airport_connectivity

# -- ML Settings ---------------------------------------------
KMEANS_K=5
RANDOM_STATE=42

# -- Streamlit Dashboard -------------------------------------
STREAMLIT_PORT=8501
